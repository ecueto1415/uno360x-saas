<odoo>
<record id="document_form" model="ir.ui.view"><field name="name">Factura fiscal electronica productiva</field><field name="model">outsolutech.ecf.document</field><field name="priority">90</field><field name="arch" type="xml"><form create="0" duplicate="0"><header>
<button name="action_preflight" type="object" string="Comprobar datos" invisible="state != 'draft'"/>
<button name="action_authenticate" type="object" string="Probar conexion DGII"/>
<button name="action_prepare" type="object" string="Asignar e-NCF y firmar" invisible="state != 'draft'" class="btn-primary" confirm="Se reservara un e-NCF autorizado para esta factura y sus datos fiscales quedaran protegidos. Todavia no se enviara a DGII."/>
<button name="action_queue" type="object" string="Emitir factura fiscal" invisible="state != 'prepared'" class="btn-primary" confirm="¿Enviar este comprobante real a la DGII?&#10;Revisa cliente, RNC, tipo y total. Una vez aceptado no podrás editarlo ni eliminarlo; corregirlo puede requerir una nota de crédito.&#10;Si cancelas, quedará preparado y sin enviar." confirm-title="Confirmar emisión fiscal" confirm-label="Sí, enviar a la DGII" cancel-label="Cancelar"/>
<button name="action_consult" type="object" string="Consultar DGII" invisible="not track_id"/>
<button name="action_reconcile" type="object" string="Conciliar por e-NCF" invisible="state != 'uncertain' or track_id"/>
<button name="action_print" type="object" string="Factura fiscal PDF" invisible="state not in ['accepted','conditional']"/>
<field name="state" widget="statusbar" statusbar_visible="draft,prepared,queued,sent,accepted"/>
</header><sheet>
<div role="status" class="alert alert-info" invisible="state in ['accepted','conditional','rejected','uncertain']">Emision real de OUTSOLUTECH. La factura adquiere validez fiscal al recibir la aceptacion de la DGII.</div>
<div role="status" class="alert alert-success" invisible="state not in ['accepted','conditional']">Comprobante aceptado por la DGII. Puede descargar el XML y la representacion impresa.</div>
<div role="status" class="alert alert-warning" invisible="state not in ['rejected','uncertain']">Revise la respuesta de la DGII antes de continuar. No cree un envio duplicado para resolver un resultado incierto.</div>
<h1><field name="name"/></h1><group><group><field name="move_id"/><field name="company_id"/><field name="environment"/><field name="document_type" readonly="state != 'draft'"/><field name="encf"/><field name="production_range_id"/><field name="income_type" readonly="state != 'draft'"/><field name="payment_type" readonly="state != 'draft'"/></group><group><field name="partner_id"/><field name="amount_total"/><field name="currency_id" invisible="1"/><field name="track_id"/><field name="last_checked"/><field name="signature_time"/><field name="security_code"/><field name="xml_filename" invisible="1"/><field name="signed_xml" filename="xml_filename"/></group></group>
<notebook><page string="Respuesta DGII"><field name="result_text"/></page><page string="Seguimiento"><group><field name="submitted_at"/><field name="attempt_count"/><field name="consultation_count"/><field name="next_check"/><field name="sequence_used"/></group></page><page string="Historial"><field name="event_ids"/></page><page string="Integridad"><group><field name="snapshot_hash"/><field name="signed_hash"/></group></page></notebook>
</sheet></form></field></record>
<record id="action_production" model="ir.actions.act_window"><field name="name">Facturacion electronica</field><field name="res_model">outsolutech.ecf.document</field><field name="view_mode">list,form</field><field name="domain">[('environment','=','ecf')]</field><field name="context">{'default_environment':'ecf'}</field></record>
<record id="production_form_view" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="document_form"/><field name="act_window_id" ref="action_production"/></record>
<menuitem id="menu_production" name="Facturacion electronica" parent="account.menu_finance" action="action_production" sequence="55" groups="account.group_account_manager"/>
<record id="move_production_button" model="ir.ui.view"><field name="name">Factura - e-CF de produccion</field><field name="model">account.move</field><field name="inherit_id" ref="outsolutech_ecf_flujo.move_form_ecf"/><field name="arch" type="xml"><xpath expr="//button[@name='action_outs_ecf_document']" position="attributes"><attribute name="invisible">move_type != 'out_invoice' or state != 'posted' or outs_ecf_production_enabled</attribute></xpath><xpath expr="//header" position="inside"><field name="outs_ecf_production_enabled" invisible="1"/><button name="action_outs_ecf_production" type="object" string="Factura fiscal electronica" groups="account.group_account_manager" invisible="move_type != 'out_invoice' or state == 'cancel' or not outs_ecf_production_enabled"/></xpath></field></record>
<record id="range_list" model="ir.ui.view"><field name="name">Secuencias e-NCF autorizadas</field><field name="model">outsolutech.ecf.range</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="document_type"/><field name="first_number"/><field name="last_number"/><field name="next_number"/><field name="valid_until"/><field name="issued_count"/><field name="active"/></list></field></record>
<record id="range_form" model="ir.ui.view"><field name="name">Autorizacion e-NCF</field><field name="model">outsolutech.ecf.range</field><field name="arch" type="xml"><form><sheet><field name="issued_count" invisible="1"/><group><field name="name"/><field name="company_id" readonly="issued_count &gt; 0"/><field name="document_type" readonly="issued_count &gt; 0"/><field name="first_number" readonly="issued_count &gt; 0"/><field name="last_number" readonly="issued_count &gt; 0"/><field name="next_number" readonly="issued_count &gt; 0"/><field name="valid_until" readonly="issued_count &gt; 0"/><field name="authorization_reference" readonly="issued_count &gt; 0"/><field name="evidence_filename" invisible="1"/><field name="evidence" filename="evidence_filename" readonly="issued_count &gt; 0"/><field name="active"/></group></sheet></form></field></record>
<record id="action_ranges" model="ir.actions.act_window"><field name="name">Secuencias e-NCF autorizadas</field><field name="res_model">outsolutech.ecf.range</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_ranges" name="Secuencias e-NCF autorizadas" parent="account.menu_finance_configuration" action="action_ranges" sequence="75" groups="account.group_account_manager"/>
<record id="company_production" model="ir.ui.view"><field name="name">Empresa - emision fiscal real</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Facturacion electronica" groups="account.group_account_manager"><group><field name="outs_ecf_production_enabled"/><button name="action_outs_ecf_production_connection" type="object" string="Probar certificado en DGII produccion"/></group><field name="outs_ecf_range_ids"/></page></xpath></field></record>

<record id="outsolutech_ecf_flujo.action_documents" model="ir.actions.act_window"><field name="domain">[('environment','!=','ecf')]</field></record>
<record id="guard_legacy_form" model="ir.ui.view"><field name="name">Separar etiquetas de pruebas y produccion</field><field name="model">outsolutech.ecf.document</field><field name="inherit_id" ref="outsolutech_ecf_flujo.document_form"/><field name="arch" type="xml">
<xpath expr="//button[@name='action_queue']" position="attributes"><attribute name="invisible">state != 'prepared' or environment == 'ecf'</attribute></xpath>
<xpath expr="//button[@name='action_print']" position="attributes"><attribute name="invisible">not signed_xml or environment == 'ecf'</attribute></xpath>
<xpath expr="//sheet/div[@role='alert']" position="attributes"><attribute name="invisible">environment == 'ecf'</attribute></xpath>
<xpath expr="//header" position="inside"><button name="action_queue" type="object" string="Emitir factura fiscal" invisible="state != 'prepared' or environment != 'ecf'" confirm="¿Enviar este comprobante real a la DGII?&#10;Revisa cliente, RNC, tipo y total. Una vez aceptado no podrás editarlo ni eliminarlo; corregirlo puede requerir una nota de crédito.&#10;Si cancelas, quedará preparado y sin enviar." confirm-title="Confirmar emisión fiscal" confirm-label="Sí, enviar a la DGII" cancel-label="Cancelar"/><button name="action_print" type="object" string="Factura fiscal PDF" invisible="environment != 'ecf' or state not in ['accepted','conditional']"/></xpath>
<xpath expr="//sheet/h1" position="before"><div role="status" class="alert alert-info" invisible="environment != 'ecf'">Comprobante de produccion. Consulte la respuesta DGII antes de entregarlo como factura fiscal.</div></xpath>
</field></record>
<record id="hide_legacy_lab_in_production" model="ir.ui.view"><field name="name">OUTSOLUTECH - ocultar laboratorio con emision productiva</field><field name="model">account.move</field><field name="inherit_id" ref="outsolutech_ecf_pruebas.view_move_form_outs_ecf_lab"/><field name="arch" type="xml">
<xpath expr="//button[@name='action_outs_generate_ecf_draft']" position="attributes"><attribute name="invisible">move_type != 'out_invoice' or state != 'posted' or outs_ecf_production_enabled</attribute></xpath>
<xpath expr="//group[field[@name='outs_ecf_draft_xml']]" position="attributes"><attribute name="invisible">move_type != 'out_invoice' or outs_ecf_production_enabled</attribute></xpath>
<xpath expr="//sheet" position="inside"><div role="status" class="alert alert-info" invisible="move_type != 'out_invoice' or state != 'draft' or not outs_ecf_production_enabled">Para emitir el comprobante fiscal, confirma primero esta factura y luego abre Factura fiscal electrónica. Confirmar la factura no la envía automáticamente a la DGII.</div></xpath>
</field></record><record id="invoice_list_fiscal_number" model="ir.ui.view"><field name="name">Factura - numero fiscal principal</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_invoice_tree"/><field name="arch" type="xml"><xpath expr="//field[@name='name']" position="before"><field name="outs_ecf_invoice_number" string="Comprobante" decoration-bf="1" readonly="1"/></xpath><xpath expr="//field[@name='name']" position="attributes"><attribute name="string">Referencia interna</attribute><attribute name="optional">hide</attribute></xpath></field></record>
<record id="invoice_search_fiscal_number" model="ir.ui.view"><field name="name">Buscar factura por e-NCF</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_account_invoice_filter"/><field name="arch" type="xml"><xpath expr="//search" position="inside"><field name="outs_ecf_invoice_number" string="Comprobante / e-NCF"/></xpath></field></record></odoo>
