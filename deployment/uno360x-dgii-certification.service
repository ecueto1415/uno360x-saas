[Unit]
Description=UNO360X isolated DGII certification receiver
After=network.target

[Service]
Type=simple
DynamicUser=yes
User=uno360x-dgii-certification
StateDirectory=uno360x-dgii-certification
StateDirectoryMode=0700
WorkingDirectory=/opt/uno360x-dgii-certification/source
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=identity.p12:/etc/odoo18/ecf-pruebas/identity.p12
LoadCredential=password:/etc/odoo18/ecf-pruebas/password
ExecStart=/opt/odoo18/venv/bin/python3.12 -m certification.receiver
Restart=on-failure
RestartSec=3
MemoryMax=192M
CPUQuota=30%
CPUWeight=10
TasksMax=24
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=/etc/odoo18.conf /etc/odoo18 /var/lib/uno360x-saas /var/lib/postgresql
UMask=0077

[Install]
WantedBy=multi-user.target
