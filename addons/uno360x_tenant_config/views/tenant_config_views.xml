<odoo>
    <record id="tenant_identity_form" model="ir.ui.view">
        <field name="name">uno360x.tenant.identity.form</field>
        <field name="model">uno360x.tenant.identity</field>
        <field name="arch" type="xml">
            <form string="Instancia UNO360X" create="false" edit="false" delete="false">
                <sheet><group>
                    <field name="tenant_id"/>
                    <field name="hostname"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="company_fiscal_details" model="ir.ui.view">
        <field name="name">res.company.uno360x.fiscal.details</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="before">
                <field name="uno360x_fiscal_legal_name" placeholder="Tal como figura en la DGII"/>
            </xpath>
        </field>
    </record>
</odoo>
