<odoo>
    <record id="access_fiscal_ranges" model="ir.model.access">
        <field name="name">Rangos fiscales de la empresa</field>
        <field name="model_id" ref="model_uno360x_ecf_range"/>
        <field name="group_id" ref="account.group_account_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_fiscal_issue" model="ir.model.access">
        <field name="name">Consultar emisión de factura</field>
        <field name="model_id" ref="model_uno360x_ecf_issue"/>
        <field name="group_id" ref="account.group_account_invoice"/>
        <field name="perm_read" eval="True"/>
    </record>
    <record id="access_fiscal_issue_wizard" model="ir.model.access">
        <field name="name">Preparar emisión electrónica</field>
        <field name="model_id" ref="model_uno360x_ecf_issue_wizard"/>
        <field name="group_id" ref="account.group_account_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>
    <record id="rule_ecf_range_company" model="ir.rule">
        <field name="name">Rangos de empresas permitidas</field>
        <field name="model_id" ref="model_uno360x_ecf_range"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ecf_issue_company" model="ir.rule">
        <field name="name">Comprobantes de empresas permitidas</field>
        <field name="model_id" ref="model_uno360x_ecf_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="view_ecf_issue_wizard" model="ir.ui.view">
        <field name="name">Confirmar emisión de factura electrónica</field>
        <field name="model">uno360x.ecf.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Emitir factura electrónica">
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount_total"/>
                    <field name="kind"/>
                    <field name="payment_type"/>
                    <field name="income_type"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar emisión" class="btn-primary"
                            confirm="Se asignará un e-NCF y se enviará el comprobante a la DGII. Si se acepta, los cambios requieren un documento fiscal de corrección."/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_ecf_issue" model="ir.ui.view">
        <field name="name">Estado de factura electrónica</field>
        <field name="model">uno360x.ecf.issue</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header><field name="state" widget="statusbar"/></header>
                <sheet><group><field name="move_id"/><field name="issuer"/><field name="encf"/><field name="track_id"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="view_move_ecf_issue" model="ir.ui.view">
        <field name="name">Emisión electrónica desde factura</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_uno360x_fiscal_open" string="Emitir factura electrónica" type="object"
                        groups="account.group_account_manager" invisible="state != 'draft' or move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="uno360x_ecf_issue_ids" nolabel="1" readonly="1" invisible="not uno360x_ecf_issue_ids"
                       groups="account.group_account_invoice">
                    <list create="0" edit="0" delete="0"><field name="encf"/><field name="state"/><field name="track_id"/></list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="view_company_ecf_issue" model="ir.ui.view">
        <field name="name">Habilitación de emisión fiscal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Facturación electrónica" groups="account.group_account_manager">
                    <group><field name="uno360x_ecf_enabled"/><field name="uno360x_ecf_fingerprint"/></group>
                    <field name="uno360x_ecf_range_ids">
                        <list editable="bottom">
                            <field name="kind"/><field name="authorization"/><field name="first_number"/>
                            <field name="last_number"/><field name="cursor_number"/><field name="expires"/><field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_tax_ecf_exempt" model="ir.ui.view">
        <field name="name">Clasificación de exención e-CF</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="uno360x_ecf_exempt" groups="account.group_account_manager"
                       invisible="amount_type != 'percent' or amount != 0"/>
            </field>
        </field>
    </record>
</odoo>
