<odoo>
<record id="action_home" model="ir.actions.act_url"><field name="name">Resumen UNO360X</field><field name="url">/uno360x-resumen</field><field name="target">self</field></record>
<template id="tree"><details t-if="node['children']" class="ux-menu-branch"><summary><t t-out="node['name']" /></summary><div class="ux-menu-children"><a t-if="node['href']" t-att-href="node['href']" class="ux-menu-leaf">Vista general</a><t t-foreach="node['children']" t-as="child"><t t-call="uno360x_workspace.tree"><t t-set="node" t-value="child" /></t></t></div></details><a t-else="" t-att-href="node['href']" class="ux-menu-leaf"><t t-out="node['name']" /></a></template>
<template id="icon"><svg class="ux-menu-icon" viewBox="0 0 20 20" aria-hidden="true"><path t-if="icon == 'sales'" d="M2 17h16M4 14V9m6 5V5m6 9V1" /><t t-elif="icon == 'finance'"><rect x="1" y="4" width="18" height="13" rx="3" /><path d="M1 8h18m-6 4h4" /></t><path t-elif="icon == 'operations'" d="M1 4h6l3 3h9v11H1z" /><t t-elif="icon == 'team'"><circle cx="7" cy="5" r="3" /><circle cx="15" cy="7" r="2.5" /><path d="M1 18c0-8 12-8 12 0m0-6c5-2 7 1 7 6" /></t><path t-elif="icon == 'ai'" d="m10 1 3 6 6 3-6 3-3 6-3-6-6-3 6-3z" /><path t-elif="icon == 'reports'" d="M2 17h16M4 14v-4m6 4V2m6 12V6" /><t t-else=""><rect x="2" y="2" width="5" height="5" rx="1" /><rect x="12" y="2" width="5" height="5" rx="1" /><rect x="2" y="12" width="5" height="5" rx="1" /><rect x="12" y="12" width="5" height="5" rx="1" /></t></svg></template>
<template id="sidebar"><aside class="ux-sidebar" id="ux-sidebar"><div class="ux-mobile-brand"><a href="/uno360x-resumen" class="ux-logo">UNO<span>360X</span></a><button class="ux-mobile-toggle" type="button" aria-controls="ux-navigation-body" aria-expanded="false" aria-label="Abrir menú">☰</button></div><div class="ux-tagline">TU EMPRESA, CONECTADA</div><div class="ux-company-card"><span class="ux-company-avatar" t-out="company.name[:1]" /><div><strong t-out="company.name" /><small>Mi empresa</small></div></div><div class="ux-navigation-body" id="ux-navigation-body"><nav class="ux-primary-navigation"><a t-att-class="'ux-primary-link active' if page_key == 'overview' else 'ux-primary-link'" href="/uno360x-resumen"><t t-call="uno360x_workspace.icon"><t t-set="icon" t-value="'home'" /></t><span>Resumen</span></a><t t-foreach="groups" t-as="group"><details class="ux-primary-item"><summary><t t-call="uno360x_workspace.icon"><t t-set="icon" t-value="group['icon']" /></t><span t-out="group['name']" /><span class="ux-menu-chev">›</span></summary><div class="ux-flyout"><t t-foreach="group['nodes']" t-as="node"><t t-call="uno360x_workspace.tree" /></t></div></details></t></nav><div class="ux-side-bottom"><a href="/uno360x-aplicaciones"><t t-call="uno360x_workspace.icon"><t t-set="icon" t-value="'home'" /></t><span>Todas las aplicaciones</span></a><a href="/uno360x-ayuda">Ayuda y soporte</a><a href="/web/session/logout" class="ux-logout-link"><svg class="ux-menu-icon" viewBox="0 0 20 20"><path d="M8 3H3v14h5M12 6l4 4-4 4M7 10h9" /></svg><span>Cerrar sesión</span></a><div class="ux-connection">Tu empresa. Todo conectado.</div></div></div></aside></template>
<template id="tools"><form class="ux-global-search" action="/uno360x-buscar" method="get"><svg class="ux-menu-icon" viewBox="0 0 20 20"><circle cx="8" cy="8" r="5" /><path d="m12 12 5 5" /></svg><input type="search" name="q" maxlength="100" placeholder="Buscar clientes, facturas, proyectos…" aria-label="Buscar en tu espacio" /></form><div class="ux-language-switch"><form action="/uno360x/language/es_DO" method="post"><input type="hidden" name="csrf_token" t-att-value="csrf" /><button t-att-class="'ux-language-active' if not en else ''">ES</button></form><form action="/uno360x/language/en_US" method="post"><input type="hidden" name="csrf_token" t-att-value="csrf" /><button t-att-class="'ux-language-active' if en else ''">EN</button></form></div></template>
<template id="shell"><html t-att-lang="u.lang or 'es_DO'"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>UNO360X - Mi empresa</title><link rel="icon" type="image/svg+xml" href="/uno360x_workspace/static/src/img/favicon.svg" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/workspace.css" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/extra.css" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/reference.css" /><link rel="stylesheet" t-att-href="'/uno360x_workspace/static/src/css/areas.css?v=' + asset_revision" /></head><body><div class="ux-app-shell"><t t-call="uno360x_workspace.sidebar" /><div class="ux-page"><header class="ux-topbar"><t t-call="uno360x_workspace.tools" /><div class="ux-profile"><span class="ux-avatar" t-out="u.name[:2].upper()" /><div><strong t-out="u.name.split(' ')[0]" /><small>Mi espacio de trabajo</small></div></div></header><t t-out="0" /><footer class="ux-footer"><span t-out="company.name" /><span>UNO360X · Tu empresa. Todo conectado.</span></footer></div></div><script src="/uno360x_workspace/static/src/js/navigation.js" defer="defer" /><script defer="defer" t-att-src="'/uno360x_workspace/static/src/js/areas.js?v=' + asset_revision" /></body></html></template>
<template id="dashboard"><t t-call="uno360x_workspace.shell"><section class="ux-intro"><div><p class="ux-eyebrow">TU NEGOCIO, EN ORDEN</p><h1>Hola, <t t-out="u.name.split(' ')[0]" />.</h1><p>Lo esencial para tomar tu próxima decisión.</p></div><form class="ux-period" method="get" action="/uno360x-resumen"><span class="ux-period-label" t-out="month_start.strftime('%m / %Y')" /><input type="month" name="period" t-att-value="month_start.strftime('%Y-%m')" aria-label="Mes del resumen" /><button class="ux-period-submit" type="submit">Ver</button></form></section>
<section class="ux-kpis"><article class="ux-kpi dark"><span class="ux-kpi-bubble">↗</span><p class="ux-kpi-label">Facturado este mes</p><div class="ux-kpi-value" t-out="money(billed) if can_finance else 'Sin acceso'" /><small><t t-if="variation is not None"><t t-out="'{:+.1f}%'.format(variation)" /> frente al mes anterior</t><t t-else="">Neto de notas de crédito</t></small></article><article class="ux-kpi"><span class="ux-kpi-bubble">↗</span><p class="ux-kpi-label">Dinero por cobrar</p><div class="ux-kpi-value" t-out="money(pending_total) if can_finance else 'Sin acceso'" /><small t-if="can_finance"><t t-out="open_count" /> facturas · <t t-out="overdue_count" /> vencidas</small></article><article class="ux-kpi"><span class="ux-kpi-bubble">↗</span><p class="ux-kpi-label" t-out="'Proyectos en marcha' if project_count is not None else 'Oportunidades abiertas'" /><div class="ux-kpi-value" t-out="project_count if project_count is not None else (opportunities if opportunities is not None else 'Sin acceso')" /><small>Disponibles para tu usuario</small></article><article class="ux-kpi"><span class="ux-kpi-bubble">≡</span><p class="ux-kpi-label" t-out="'Empleados activos' if employee_count is not None else 'Cotizaciones por seguir'" /><div class="ux-kpi-value" t-out="employee_count if employee_count is not None else (stale_quotes if can_sales else 'Sin acceso')" /><small t-out="'Consulta las fichas de tu equipo' if employee_count is not None else 'Enviadas y pendientes de respuesta'" /></article></section>
<div class="ux-chart-row"><section class="ux-card"><div class="ux-card-heading"><div><h2>¿Cómo va tu facturación?</h2><p class="ux-card-subtitle">Facturación neta por mes · <t t-out="company.currency_id.name" /></p></div><span class="ux-range">Últimos 6 meses</span></div><t t-if="can_finance"><div class="ux-chart-scroll"><div class="ux-chart-inner"><div class="ux-chart-grid" style="top:0px" /><div class="ux-chart-grid" style="top:50px" /><div class="ux-chart-grid" style="top:100px" /><div class="ux-chart-grid" style="top:150px" /><div class="ux-bar-grid"><t t-foreach="series" t-as="bar"><div class="ux-bar-column"><div class="ux-bar" t-att-style="'height:%spx;bottom:%spx' % (abs(bar['value'])/chart_span*150,(-chart_min)/chart_span*150 if bar['value'] &gt;= 0 else (-chart_min+bar['value'])/chart_span*150)" t-att-title="money(bar['value'])" /><span class="ux-bar-month" t-out="bar['date'].strftime('%m/%y')" /></div></t></div></div></div><p class="ux-chart-note">Cada barra es un mes. Se descuentan las notas de crédito.</p></t><p t-else="" class="ux-empty">Tu perfil no tiene acceso a la información financiera.</p></section><section class="ux-card"><h2>¿Cuánto has cobrado?</h2><p class="ux-card-subtitle">De lo facturado neto en el mes seleccionado</p><div t-if="can_finance" class="ux-collection-body"><div class="ux-donut" t-attf-style="background:conic-gradient(#138a73 {{ ring_percent }}%,#f3dcd3 0)"><div class="ux-donut-center"><strong t-out="'{:.0f}%'.format(ring_percent) if billed &gt; 0 else '—'" /><small t-out="'cobrado' if billed &gt; 0 else 'Sin facturación'" /></div></div><div class="ux-collection-legend"><div class="ux-legend-item"><div class="ux-legend-label"><span class="ux-dot" />Cobrado</div><strong t-out="money(period_settled)" /></div><div class="ux-legend-item"><div class="ux-legend-label"><span class="ux-dot coral" />Pendiente</div><strong t-out="money(period_pending)" /></div></div></div><p t-else="" class="ux-empty">Tu perfil no tiene acceso a la información financiera.</p></section></div>
<div class="ux-bottom-row"><section class="ux-card"><h2 t-out="'Tus proyectos, paso a paso' if project_count is not None else ('Tu equipo, al día' if employee_count is not None else ('Consulta a Jenifer' if 'jenifer_ai' in options else 'Tu actividad comercial'))" /><t t-if="project_count is not None"><div t-foreach="projects" t-as="project" class="ux-plan-row"><strong t-out="project.name" /></div><p t-if="not projects" class="ux-empty">Aún no hay proyectos disponibles para tu usuario.</p></t><t t-elif="employee_count is not None"><p class="ux-empty"><t t-out="employee_count" /> empleados activos. Abre Equipo para consultar fichas, asistencias y ausencias.</p></t><t t-elif="'jenifer_ai' in options"><p class="ux-empty">Consultas de solo lectura con tus permisos.</p><a class="ux-button" href="/uno360x-jenifer">Abrir Jenifer</a></t><t t-else=""><div class="ux-plan-row"><strong>Contactos, CRM y ventas</strong><span>Desde Comercial</span></div><div class="ux-plan-row"><strong>Punto de venta</strong><span>Abrir desde Comercial</span></div></t></section><section class="ux-card"><h2>Lo que necesita tu atención</h2><div t-if="can_finance" class="ux-attention-row"><span class="ux-dot coral" /><div class="ux-attention-copy"><strong><t t-out="overdue_count" /> facturas vencidas</strong><small>Prioriza estos cobros</small></div></div><div t-if="can_sales" class="ux-attention-row"><span class="ux-dot" style="background:#e8af50" /><div class="ux-attention-copy"><strong><t t-out="stale_quotes" /> cotizaciones por seguir</strong><small>Enviadas y sin actualizar hace 7 días</small></div></div></section></div></t></template>
<template id="apps"><t t-call="uno360x_workspace.shell"><section class="ux-intro"><div><p class="ux-eyebrow">TU ESPACIO</p><h1>Todas las aplicaciones</h1><p>Herramientas disponibles según tu alcance y tus permisos.</p></div></section><div class="ux-catalog"><section t-foreach="groups" t-as="group" class="ux-card"><h2 t-out="group['name']" /><t t-foreach="group['nodes']" t-as="node"><t t-call="uno360x_workspace.tree" /></t></section></div></t></template>
<template id="help"><t t-call="uno360x_workspace.shell"><section class="ux-intro"><div><h1>Ayuda y soporte</h1><p>Tu empresa. Todo conectado.</p></div></section><section class="ux-card"><h2>Comienza por Resumen</h2><p>Usa Comercial para contactos, CRM, ventas y caja; Finanzas para documentos y cobros; Operaciones para compras e inventario.</p><p>Los módulos de tu empresa aparecen dentro de los mismos grupos. Todas las aplicaciones respeta los permisos de tu usuario.</p><p>La emisión fiscal requiere configuración y habilitación independiente. Ningún dato de otra empresa se comparte en este entorno.</p><a href="https://uno360x.com/#contacto" rel="noopener" target="_blank">Contactar soporte UNO360X</a></section></t></template>
<template id="search"><t t-call="uno360x_workspace.shell"><section class="ux-intro"><div><h1>Buscar en tu empresa</h1><p>Resultados para: <t t-out="query" /></p></div></section><section class="ux-card"><p t-if="not results">No hay coincidencias disponibles con tus permisos.</p><div t-foreach="results" t-as="item" class="ux-plan-row"><strong t-out="item['name']" /><a t-att-href="item['href']">Abrir <t t-out="item['kind']" /></a></div></section></t></template>
<template id="jenifer"><t t-call="uno360x_workspace.shell"><section class="ux-intro"><div><p class="ux-eyebrow">TU ASISTENTE</p><h1>Hola, soy Jenifer.</h1><p>Consultas de solo lectura. Respeto los permisos de tu usuario.</p></div></section><section class="ux-card"><form method="post" action="/uno360x-jenifer"><input type="hidden" name="csrf_token" t-att-value="csrf" /><label for="question">¿Qué necesitas consultar?</label><textarea id="question" name="question" maxlength="500" rows="3" placeholder="CxC, CxP o cotizaciones pendientes" required="required"><t t-out="question" /></textarea><button class="ux-button" type="submit">Consultar</button></form><pre t-if="answer" class="ux-answer" t-out="answer" /></section></t></template>
<template id="native" inherit_id="web.layout" priority="99"><xpath expr="//head" position="inside"><t t-if="request.env.user.has_group('base.group_user') and (request.httprequest.path.startswith('/odoo') or request.httprequest.path == '/web')"><link rel="icon" type="image/svg+xml" href="/uno360x_workspace/static/src/img/favicon.svg" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/workspace.css" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/native.css" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/brand.css" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/extra.css" /><link rel="stylesheet" href="/uno360x_workspace/static/src/css/reference.css" /><link rel="stylesheet" t-att-href="'/uno360x_workspace/static/src/css/areas.css?v=' + request.env['ir.config_parameter'].sudo().get_param('uno360x.workspace.release','18.0.2.0.0')" /></t></xpath><xpath expr="//body" position="inside"><t t-if="request.env.user.has_group('base.group_user') and (request.httprequest.path.startswith('/odoo') or request.httprequest.path == '/web')"><t t-set="ux" t-value="request.env['uno360x.workspace']._workspace_context()" /><t t-set="company" t-value="ux['company']" /><t t-set="u" t-value="ux['u']" /><t t-set="en" t-value="ux['en']" /><t t-set="groups" t-value="ux['groups']" /><t t-set="page_key" t-value="'module'" /><t t-set="csrf" t-value="request.csrf_token()" /><div class="ux-native-shell"><t t-call="uno360x_workspace.sidebar" /><div id="ux-native-header" class="ux-native-header" t-att-data-user="u.id" t-att-data-company="company.id"><t t-call="uno360x_workspace.tools" /><span id="ux-native-title" class="ux-native-title" /></div><div class="ux-native-mobilebar"><a class="ux-logo" href="/uno360x-resumen">UNO<span>360X</span></a><button id="ux-native-open" aria-expanded="false" aria-label="Abrir menú">☰</button></div><button id="ux-native-backdrop" class="ux-native-backdrop" aria-label="Cerrar menú" /></div><script src="/uno360x_workspace/static/src/js/native.js" defer="defer" /><script defer="defer" t-att-src="'/uno360x_workspace/static/src/js/areas.js?v=' + request.env['ir.config_parameter'].sudo().get_param('uno360x.workspace.release','18.0.2.0.0')" /></t></xpath></template>
<record id="uno360x_partner_website_example" model="ir.ui.view">
 <field name="name">uno360x.partner.website.example</field><field name="model">res.partner</field>
 <field name="inherit_id" ref="base.view_partner_form" />
 <field name="arch" type="xml"><xpath expr="//field[@name='website']" position="attributes"><attribute name="placeholder">Por ejemplo, https://tuempresa.com</attribute></xpath></field>
</record></odoo>