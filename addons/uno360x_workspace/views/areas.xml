<odoo>
<template id="area"><t t-call="uno360x_workspace.shell"><main class="ua-area" t-att-data-area="area_key" t-att-data-user="u.id" t-att-data-company="company.id" t-att-data-lang="u.lang or 'es_DO'" t-att-data-tz="u.tz or 'UTC'">
<t t-if="area_kind=='reports'"><t t-call="uno360x_workspace.board_content"/></t>
<t t-else="">
<header class="ua-heading"><div><p class="ux-eyebrow"><t t-out="area_group"/> / <t t-out="area_title"/></p><h1 t-out="area_title"/></div><a t-if="area_can_create" class="ua-primary" t-att-href="area_create">+ <t t-out="area_create_label"/></a></header>
<section t-if="area_key == 'billing' and area_finance_shortcuts" class="ua-cards" aria-label="Cuentas y bancos">
 <article t-foreach="area_finance_shortcuts" t-as="shortcut" class="ua-panel">
  <div class="ua-replenish-toolbar"><a class="ua-primary" t-att-href="shortcut['create']" t-out="shortcut['name']"/><a t-if="shortcut['name'] == 'Agregar banco'" class="ua-primary" href="/uno360x/finanzas/cheques">Cheques</a><a t-att-href="shortcut['list']" t-out="shortcut['list_name']"/></div>
 </article>
</section>
<div t-if="area_key == 'inventory' and inventory_shortage_report" class="ua-replenish-toolbar"><a class="ua-primary" href="/uno360x/inventory/shortage-report">Generar informe de faltantes</a></div>
<div t-if="inventory_product_saved" class="ua-inventory-saved" role="status">Producto guardado.</div>
<nav class="ua-tabs" aria-label="Vistas del área"><a t-foreach="area_tabs" t-as="tab" t-att-href="tab['href']" t-att-class="'active' if tab['active'] else ''" t-att-aria-current="'page' if tab['active'] else None" t-out="tab['name']"/><a t-if="can_invoice_templates" href="/uno360x/ventas/plantillas">Plantillas de facturación</a><a t-if="area_action" t-att-href="area_action" t-out="'Facturar por lote' if area_key == 'sales' and selection == 'invoice' else 'Vista completa'"/><details t-if="area_tools" class="ua-tools"><summary>Informes y configuración</summary><div><a t-foreach="area_tools" t-as="tool" t-att-href="tool['href']" t-out="tool['name']"/></div></details></nav>
<section class="ua-kpis" aria-label="Resumen del área"><article t-foreach="area_metrics" t-as="metric"><p t-out="metric[0]"/><strong t-out="metric[1]"/></article></section>
<form class="ua-filters" method="get"><input name="q" type="search" maxlength="100" placeholder="Buscar en esta lista…" aria-label="Buscar en esta lista" t-att-value="query"/><input name="selection" type="hidden" t-att-value="selection"/><label t-if="area_kind=='calendar'">Mes <input type="month" name="period" t-att-value="area_month"/></label><button class="ua-primary" type="submit">Buscar</button><button class="ua-save-filter" type="button">Guardar filtro</button><button class="ua-restore-filter" type="button" hidden="hidden">Mi filtro</button><span class="ua-filter-status" role="status"/><span class="ua-count"><t t-out="area_total"/> registros</span></form>
<t t-if="area_kind=='calendar'"><section class="ua-panel ua-calendar-panel"><h2>Calendario del equipo · <t t-out="area_month"/></h2><div class="ua-calendar" role="table"><div t-foreach="['LUN','MAR','MIÉ','JUE','VIE','SÁB','DOM']" t-as="day" class="ua-calendar-label" role="columnheader" t-out="day"/><t t-foreach="area_calendar" t-as="week"><div t-foreach="week" t-as="day" t-att-class="'ua-calendar-day' if day['current'] else 'ua-calendar-day muted'" role="cell"><span t-out="day['day']"/><small t-foreach="day['events']" t-as="event" t-out="event"/></div></t></div></section></t>
<t t-if="area_kind=='board'"><section class="ua-board" aria-label="Tablero por etapas"><article t-foreach="area_boards" t-as="board" class="ua-board-column"><h2><t t-out="board['name']"/> <small t-out="len(board['items'])"/></h2><a t-foreach="board['items']" t-as="row" class="ua-board-card" t-att-href="row['href']"><strong t-out="row['name']"/><p t-out="row['subtitle']"/><span>Abrir y dar seguimiento →</span></a></article></section><p t-if="area_boards" class="ua-note">Para mover etapas o usar todos los filtros, abre Vista completa.</p></t>
<t t-elif="area_kind in ('cards','pos')"><section class="ua-cards"><article class="ua-record-card" t-foreach="area_rows" t-as="row"><div class="ua-record-title"><span class="ua-initials" t-out="row['initials']"/><h2 t-out="row['name']"/></div><p t-out="row['subtitle']"/><div t-if="row['progress'] is not None" class="ua-progress" role="progressbar" t-att-aria-valuenow="row['progress']" aria-valuemin="0" aria-valuemax="100"><span t-attf-style="width: {{ row['progress'] }}%"/></div><t t-if="area_kind=='pos'"><form method="post" t-att-action="'/uno360x/pos/open/%s'%row['id']"><input type="hidden" name="csrf_token" t-att-value="csrf"/><button class="ua-primary"><t t-out="'Continuar venta' if row['pos_open'] else 'Abrir turno'"/></button></form><a t-if="row['href']" t-att-href="row['href']">Ver configuración y sesiones</a></t><a t-elif="row['href']" class="ua-link" t-att-href="row['href']">Abrir <t t-out="'proyecto y tareas' if area_key=='projects' else 'ficha'"/> →</a></article></section></t>
<t t-else=""><section class="ua-table-panel" t-if="area_rows"><table class="ua-table"><thead><tr><th t-foreach="area_columns" t-as="column" scope="col" t-out="column"/></tr></thead><tbody><tr t-foreach="area_rows" t-as="row"><td t-foreach="row['cells']" t-as="cell" t-att-data-label="area_columns[cell_index]"><a t-if="cell_index==0 and row['href']" t-att-href="row['href']" t-out="cell['text']"/><t t-else=""><span t-att-class="'ua-stock-low' if cell.get('stock_low') else ('ua-paid' if cell['paid'] or cell.get('fiscal_payment_badge') else '')" t-att-style="'background:#fde68a;color:#713f12;white-space:nowrap' if cell.get('fiscal_payment_badge') == 'credit' else ('background:#fee2e2;color:#991b1b;white-space:nowrap' if cell.get('fiscal_payment_badge') == 'reversed' else None)" t-out="cell['text']"/><small t-if="cell.get('stock_low')" class="ua-stock-low-label">Stock bajo</small></t></td></tr></tbody></table></section></t>
<section t-if="area_kind != 'reports' and not area_rows" class="ua-panel ua-empty"><t t-if="area_key == 'sales' and selection == 'invoice'"><h2>No se encontraron órdenes para facturar</h2><p t-if="query">Prueba con otra búsqueda.</p><p t-else="">Aquí aparecerán los pedidos con cantidades pendientes de facturar.</p><a class="ua-link" href="/uno360x/area/sales?selection=orders">Ver pedidos</a></t><t t-else=""><h2>No hay registros para esta selección</h2><p>Cambia la búsqueda o crea tu primer registro si tu perfil tiene permiso.</p></t><a t-if="area_can_create" class="ua-primary" t-att-href="area_create">+ <t t-out="area_create_label"/></a><t t-if="area_key=='pos' and area_can_create"><p>También puedes crear tu primera caja aquí:</p><form method="post" action="/uno360x/pos/create"><input type="hidden" name="csrf_token" t-att-value="csrf"/><label>Nombre de la caja <input name="name" maxlength="80" required="required"/></label><button class="ua-primary">Crear mi primera caja</button></form></t></section>
<nav class="ua-pagination" aria-label="Páginas de resultados"><a t-if="area_previous" t-att-href="area_previous">← Anterior</a><span>Página <t t-out="area_page"/> de <t t-out="area_pages"/></span><a t-if="area_next" t-att-href="area_next">Siguiente →</a></nav></t>
<footer class="ua-data-context">Actualizado: <t t-out="area_updated"/> · <t t-out="company.name"/> · <t t-out="area_currency"/></footer></main></t></template>
<template id="area_jenifer"><t t-call="uno360x_workspace.shell"><main class="ua-area" data-area="jenifer" t-att-data-user="u.id" t-att-data-company="company.id"><header class="ua-heading"><div><p class="ux-eyebrow">JENIFER IA / ASISTENTE</p><h1>Jenifer</h1></div></header><nav class="ua-tabs"><a href="#asistente" class="active">Asistente</a><a href="#historial">Historial de esta sesión</a></nav><div class="ua-report-grid"><section class="ua-panel" id="asistente"><h2>¿Qué necesitas consultar?</h2><p>Datos de tu empresa según tus permisos.</p><form method="post" action="/uno360x-jenifer"><input type="hidden" name="csrf_token" t-att-value="csrf"/><div class="ua-suggestions"><button name="question" value="CxC">Cuentas por cobrar vencidas</button><button name="question" value="CxP">Cuentas por pagar vencidas</button><button name="question" value="Cotizaciones pendientes">Cotizaciones pendientes</button></div></form><form method="post" action="/uno360x-jenifer"><input type="hidden" name="csrf_token" t-att-value="csrf"/><label for="question">Escribe una consulta</label><textarea id="question" name="question" maxlength="500" rows="3" required="required" placeholder="CxC, CxP o cotizaciones pendientes"><t t-out="question"/></textarea><button class="ua-primary">Consultar</button></form><pre t-if="answer" class="ux-answer" t-out="answer"/><p class="ua-note">Consulta de solo lectura. No se envían correos.</p></section><aside class="ua-panel"><h2>Alcance de tu asistente</h2><p>Consultas de cuentas por cobrar, cuentas por pagar y cotizaciones.</p><p>La IA externa y el flujo de licitaciones aún no están habilitados en SaaS.</p></aside></div><section class="ua-panel" id="historial"><h2>Historial de esta sesión</h2><p t-if="not history">Tus consultas aparecerán aquí.</p><details t-foreach="history" t-as="item"><summary t-out="item['question']"/><pre class="ux-answer" t-out="item['answer']"/></details></section></main></t></template>
<template id="board_content">
 <div class="ux-boards">
  <header class="ua-heading">
   <div><p class="ux-eyebrow">Reportes / Tableros</p><h1>Tableros</h1></div>
   <form method="get" action="/uno360x/area/reports" class="ux-board-period">
    <input type="hidden" name="selection" t-att-value="board_key"/>
    <label>Período <input type="month" name="period" required="required" t-att-value="board_month"/></label>
    <button class="ua-primary" type="submit">Aplicar</button>
   </form>
  </header>
  <nav class="ua-tabs ux-board-tabs" aria-label="Tableros">
   <a t-foreach="board_tabs" t-as="tab" t-att-href="tab['href']" t-att-class="'active' if tab['active'] else ''" t-att-aria-current="'page' if tab['active'] else None" t-out="tab['label']"/>
  </nav>
  <section t-if="board_metrics" class="ua-kpis ux-board-kpis" aria-label="Indicadores">
   <article t-foreach="board_metrics" t-as="metric">
    <a t-att-href="metric['href']"><span t-out="metric['label']"/><strong t-out="metric['value']"/></a>
   </article>
  </section>
  <section t-if="board_detail" class="ua-panel ux-board-detail" aria-label="Detalle del indicador">
   <div class="ux-board-panel-title"><h2 t-out="board_detail['label']"/><a t-att-href="board_back">Cerrar detalle</a></div>
   <p t-if="not board_detail_rows">No hay registros para este indicador.</p>
   <ul class="ux-board-list" t-else=""><li t-foreach="board_detail_rows" t-as="record" t-out="record"/></ul>
   <p t-if="board_detail_total &gt; len(board_detail_rows)">Se muestran <t t-out="len(board_detail_rows)"/> de <t t-out="board_detail_total"/> registros.</p>
  </section>
  <div t-if="board_chart or board_pending" class="ux-board-grid">
   <section t-if="board_chart" class="ua-panel">
    <h2 t-out="board_chart_title"/>
    <p t-if="not any(bar['value'] for bar in board_chart)">No hay movimientos en este período.</p>
    <ul t-else="" class="ux-board-bars" aria-label="Totales por tramo del mes">
     <li t-foreach="board_chart" t-as="bar">
      <span t-out="bar['label']"/><span class="ux-board-track" aria-hidden="true"><i t-attf-style="width: {{ bar['width'] }}%"/></span><strong t-out="bar['display']"/>
     </li>
    </ul>
   </section>
   <section t-if="board_pending" class="ua-panel">
    <h2>Requiere atención</h2>
    <ul class="ux-board-list">
     <li t-foreach="board_pending" t-as="item"><a t-att-href="item['href']"><span t-out="item['label']"/><strong t-out="item['value']"/></a></li>
    </ul>
   </section>
  </div>
  <section t-if="not board_metrics and not board_chart and not board_pending" class="ua-panel">
   <h2>Sin indicadores disponibles</h2><p>Los tableros muestran los datos a los que tienes acceso.</p>
  </section>
 </div>
</template>
</odoo>