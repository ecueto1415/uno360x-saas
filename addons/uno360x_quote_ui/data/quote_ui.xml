<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="field_quote_pdf_versions" model="ir.model.fields">
    <field name="name">x_ux_quote_pdf_version_ids</field>
    <field name="field_description">Versiones PDF del presupuesto</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="ttype">many2many</field>
    <field name="relation">ir.attachment</field>
    <field name="relation_table">x_ux_quote_pdf_version_rel</field>
    <field name="column1">order_id</field>
    <field name="column2">attachment_id</field>
    <field name="state">manual</field>
    <field name="copied" eval="False"/>
  </record>

  <record id="action_save_pdf_version" model="ir.actions.server">
    <field name="name">UNO360X - Guardar versión PDF del presupuesto</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="state">code</field>
    <field name="code">
if not env['uno360x.tenant.identity'].sudo().search_count([]):
    raise UserError('La instancia necesita una identidad UNO360X antes de guardar versiones.')
if not record or len(record) != 1:
    raise UserError('Abre un solo presupuesto guardado para crear su versión PDF.')
record.read(['name', 'amount_total', 'currency_id', 'company_id'])
if record.company_id not in env.companies:
    raise UserError('Selecciona la compañía del presupuesto antes de guardar la versión.')
pdf_content, output_type = env['ir.actions.report'].with_context(report_pdf_no_attachment=True)._render_qweb_pdf('sale.action_report_saleorder', res_ids=record.ids)
if not pdf_content or output_type != 'pdf':
    raise UserError('No se pudo generar el PDF; no se ha guardado una versión.')
version_number = len(record.x_ux_quote_pdf_version_ids) + 1
version_name = 'UNO360X %s - V%s.pdf' % (record.name, version_number)
attachment = env['ir.attachment'].create({
    'name': version_name,
    'type': 'binary',
    'raw': pdf_content,
    'mimetype': 'application/pdf',
    'res_model': 'sale.order',
    'res_id': record.id,
    'description': 'Copia PDF V%s del presupuesto %s. Estado al guardar: %s. Total: %s %s. Autor: %s.' % (version_number, record.name, record.state, record.amount_total, record.currency_id.name, env.user.display_name),
})
record.write({'x_ux_quote_pdf_version_ids': [(4, attachment.id)]})
action = {'type': 'ir.actions.client', 'tag': 'reload'}
    </field>
  </record>

  <record id="action_open_pdf_version" model="ir.actions.server">
    <field name="name">UNO360X - Ver previo de versión PDF</field>
    <field name="model_id" ref="base.model_ir_attachment"/>
    <field name="state">code</field>
    <field name="code">
if not record or len(record) != 1 or record.res_model != 'sale.order':
    raise UserError('Selecciona una versión PDF de un presupuesto.')
record.read(['name', 'res_model', 'res_id'])
order = env['sale.order'].browse(record.res_id).exists()
order.read(['name'])
if not order or record not in order.x_ux_quote_pdf_version_ids:
    raise UserError('El documento no pertenece al historial de versiones de este presupuesto.')
action = {'type': 'ir.actions.act_url', 'url': '/web/content/%s?download=false' % record.id, 'target': 'new'}
    </field>
  </record>

  <record id="field_quote_version_count" model="ir.model.fields">
<field name="name">x_ux_quote_version_count</field><field name="field_description">Versiones guardadas</field><field name="model_id" ref="sale.model_sale_order"/><field name="ttype">integer</field><field name="state">manual</field><field name="readonly" eval="True"/><field name="store" eval="False"/><field name="depends">x_ux_quote_pdf_version_ids</field><field name="compute">for record in self:
    record['x_ux_quote_version_count'] = len(record.x_ux_quote_pdf_version_ids)</field>
</record>
<record id="field_quote_document_ids" model="ir.model.fields">
