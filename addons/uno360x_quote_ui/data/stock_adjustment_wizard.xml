<odoo>
    <record id="stock_adjustment_wizard_form" model="ir.ui.view">
        <field name="name">uno360x.stock.adjustment.wizard.form</field>
        <field name="model">uno360x.stock.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="Corregir stock">
                <field name="company_id" invisible="1"/>
                <group>
                    <field name="product_tmpl_id" force_save="1" options="{'no_open': True}"/>
                    <field name="warehouse_id" domain="[('company_id', '=', company_id)]"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <group col="4">
                    <field name="before_qty" force_save="1"/>
                    <field name="counted_qty"/>
                </group>
                <group>
                    <field name="delta_qty" string="Ajuste de inventario"/>
                    <field name="reason" placeholder="Ej. Conteo físico: se encontraron 9 unidades en el estante."/>
                </group>
                <p class="text-muted">Al confirmar, se registra tu usuario, la fecha y el motivo.</p>
                <footer>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    <button name="action_apply" string="Confirmar ajuste" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
