<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_convert_barcode" model="ir.ui.view">
        <field name="name">product.template.uno360x.convert.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <button name="action_uno360x_convert_barcode"
                        type="object"
                        string="Convertir en código de barras"
                        class="btn btn-link p-0"
                        invisible="barcode or product_variant_count &gt; 1 or type in ['service', 'combo']"/>
            </field>
        </field>
    </record>
</odoo>
