<odoo>
  <record id="employee_approved_brand" model="ir.ui.view">
    <field name="name">uno360x.employee.approved.brand</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form" />
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes">
        <attribute name="class" add="uef-form" separator=" " />
      </xpath>
      <xpath expr="//sheet" position="before">
        <div class="uef-topline">
          <div>
            <small>Empleados / Ficha completa</small>
            <h1>Ficha del empleado</h1>
          </div>
          <a href="/uno360x-empleados" class="uef-back">← Volver al directorio</a>
        </div>
      </xpath>
      <xpath expr="//sheet" position="attributes">
        <attribute name="class" add="uef-sheet" separator=" " />
      </xpath>
      <xpath expr="//div[contains(@class,'row')][div[contains(@class,'oe_title')]]" position="attributes">
        <attribute name="class" add="uef-hero" separator=" " />
      </xpath>
      <xpath expr="//div[contains(@class,'o_employee_avatar')]" position="inside">
        <div class="uef-photo-hint">Editar foto</div>
      </xpath>
      <xpath expr="//page[@name='public']" position="attributes">
        <attribute name="string">Jornada y ubicación</attribute>
      </xpath>
      <xpath expr="//page[@name='personal_information']" position="attributes">
        <attribute name="string">Datos privados</attribute>
      </xpath>
      <xpath expr="//page[@name='personal_information']" position="before">
        <page name="uef_contract_payroll" string="Contrato y nómina" groups="hr.group_hr_user">
          <div class="uef-section-title">Contratos del empleado</div>
          <field name="contract_ids" class="uef-contracts" readonly="1" context="{'active_test':False}">
            <list create="0" edit="0" delete="0">
              <field name="name" />
              <field name="date_start" />
              <field name="date_end" />
              <field name="state" />
              <field name="currency_id" column_invisible="True" />
              <field name="wage" string="Salario mensual" />
            </list>
          </field>
        </page>
        <page name="uef_documents" string="Documentos" groups="hr.group_hr_user">
          <div class="uef-section-title">Expediente del empleado</div>
          <p class="uef-description">Adjunta y consulta CV, contratos y documentos desde el historial de esta ficha. Los documentos respetan los permisos del empleado.</p>
        </page>
      </xpath>
    </field>
  </record>
</odoo>