<odoo>
  <record id="payroll_contracts" model="ir.actions.act_window">
    <field name="name">Contratos y salarios</field>
    <field name="res_model">hr.contract</field>
    <field name="path">payroll-contracts</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="payroll_receipts" model="ir.actions.act_window">
    <field name="name">Recibos de nómina</field>
    <field name="res_model">uno360x.payroll.receipt</field>
    <field name="path">payroll-receipts</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="payroll_receipt_list" model="ir.ui.view">
    <field name="name">uno360x.payroll.receipt.list</field>
    <field name="model">uno360x.payroll.receipt</field>
    <field name="arch" type="xml">
      <list><field name="name"/><field name="employee_id"/><field name="date"/></list>
    </field>
  </record>
  <record id="payroll_receipt_form" model="ir.ui.view">
    <field name="name">uno360x.payroll.receipt.form</field>
    <field name="model">uno360x.payroll.receipt</field>
    <field name="arch" type="xml">
      <form><sheet><group><field name="name"/><field name="employee_id"/><field name="date"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="filename" invisible="1"/><field name="document" filename="filename"/>
      </group></sheet></form>
    </field>
  </record>
  <menuitem id="menu_payroll_root" name="Nómina" sequence="45" groups="group_payroll"/>
  <menuitem id="menu_payroll_contracts" name="Contratos y salarios" parent="menu_payroll_root"
            action="payroll_contracts" groups="group_payroll"/>
  <menuitem id="menu_payroll_receipts" name="Recibos de nómina" parent="menu_payroll_root"
            action="payroll_receipts" groups="group_payroll"/>
</odoo>
