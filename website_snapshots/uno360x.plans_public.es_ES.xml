(function(){function init(){const root=document.getElementById('uno360x-public');if(!root)return;const inputs=[...root.querySelectorAll('[data-module]')];function refresh(){const list=root.querySelector('.p-selection');list.replaceChildren();const base=document.createElement('li');base.textContent='✓ Base Empresarial';const detail=document.createElement('small');detail.textContent='Plan principal';base.append(detail);list.append(base);inputs.forEach(input=&gt;{input.closest('label').querySelector('.p-state').textContent=input.checked?'✓ Agregado':'+ Agregar';if(input.checked){const li=document.createElement('li');li.textContent='✓ '+input.dataset.module;const small=document.createElement('small');small.textContent='Módulo agregado';li.append(small);list.append(li);}});}inputs.forEach(i=&gt;i.addEventListener('change',refresh));root.querySelectorAll('[data-period]').forEach(button=&gt;button.addEventListener('click',()=&gt;{const annual=button.dataset.period==='anual';root.querySelectorAll('[data-period]').forEach(b=&gt;b.setAttribute('aria-pressed',String(b===button)));root.querySelectorAll('.p-unit').forEach(e=&gt;e.textContent=annual?'año':'mes');root.querySelector('.p-subscription').textContent=annual?'anual':'mensual';root.querySelector('.p-total-period').textContent=annual?'ANUAL':'MENSUAL';}));refresh();}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}})();
